<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #17202a;
            background:
                radial-gradient(circle at top left, rgba(47, 128, 237, 0.12), transparent 30%),
                linear-gradient(135deg, #f7fafc 0%, #eef4f8 100%);
            display: grid;
            place-items: center;
            padding: 24px;
        }

        .auth-shell {
            width: 100%;
            max-width: 440px;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.94);
            border: 1px solid rgba(122, 139, 158, 0.22);
            border-radius: 8px;
            box-shadow: 0 24px 70px rgba(28, 45, 64, 0.14);
            padding: 36px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
            color: #2f80ed;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #2f80ed;
            color: #ffffff;
            display: grid;
            place-items: center;
            font-weight: 800;
            letter-spacing: 0;
        }

        h1 {
            margin: 0 0 10px;
            color: #111827;
            font-size: 30px;
            line-height: 1.2;
            letter-spacing: 0;
        }

        p {
            margin: 0 0 28px;
            color: #5f6f82;
            font-size: 15px;
            line-height: 1.6;
        }

        form {
            display: grid;
            gap: 16px;
        }

        label {
            color: #344054;
            font-size: 14px;
            font-weight: 650;
        }

        input {
            width: 100%;
            border: 1px solid #d0d7de;
            border-radius: 8px;
            background: #ffffff;
            color: #111827;
            font: inherit;
            padding: 14px 15px;
            outline: none;
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }

        input:focus {
            border-color: #2f80ed;
            box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.14);
        }

        button {
            border: 0;
            border-radius: 8px;
            background: #1f6feb;
            color: #ffffff;
            cursor: pointer;
            font: inherit;
            font-weight: 750;
            padding: 14px 18px;
            transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
            box-shadow: 0 12px 24px rgba(31, 111, 235, 0.22);
        }

        button:hover {
            background: #185abc;
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }

        .support-note {
            margin-top: 22px;
            color: #7a8b9e;
            font-size: 13px;
            line-height: 1.5;
            text-align: center;
        }

        @media (max-width: 480px) {
            body {
                padding: 16px;
            }

            .auth-card {
                padding: 28px 22px;
            }

            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-card" aria-labelledby="forgot-password-title">
            <div class="brand">
                <span class="brand-mark">K</span>
                <span>Kodex Auth</span>
            </div>

            <h1 id="forgot-password-title">Reset your password</h1>
            <p>Enter your registered email address and we will send you a secure password reset link.</p>

            <form action="http://localhost:3000/api/auth/forgot-password" method="post">
                <label for="email">Email address</label>
                <input id="email" type="text" name="email" placeholder="Enter your email">
                <button type="submit">Send reset link</button>
            </form>

            <div class="support-note">Use the email connected with your account.</div>
        </section>
    </main>
</body>
</html>
