<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Password</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #17202a;
            background:
                radial-gradient(circle at top right, rgba(39, 174, 96, 0.13), transparent 32%),
                linear-gradient(135deg, #f7fafc 0%, #eef4f8 100%);
            display: grid;
            place-items: center;
            padding: 24px;
        }

        .auth-shell {
            width: 100%;
            max-width: 460px;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(122, 139, 158, 0.22);
            border-radius: 8px;
            box-shadow: 0 24px 70px rgba(28, 45, 64, 0.14);
            padding: 36px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
            color: #1f7a4d;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #1f7a4d;
            color: #ffffff;
            display: grid;
            place-items: center;
            font-weight: 800;
            letter-spacing: 0;
        }

        h1 {
            margin: 0 0 10px;
            color: #111827;
            font-size: 30px;
            line-height: 1.2;
            letter-spacing: 0;
        }

        p {
            margin: 0 0 26px;
            color: #5f6f82;
            font-size: 15px;
            line-height: 1.6;
        }

        .account-chip {
            display: inline-flex;
            align-items: center;
            max-width: 100%;
            margin-bottom: 22px;
            border: 1px solid #d8e2dc;
            border-radius: 8px;
            background: #f6fbf8;
            color: #1f7a4d;
            font-size: 13px;
            font-weight: 650;
            padding: 9px 11px;
            overflow-wrap: anywhere;
        }

        form {
            display: grid;
            gap: 16px;
        }

        .field {
            display: grid;
            gap: 8px;
        }

        label {
            color: #344054;
            font-size: 14px;
            font-weight: 650;
        }

        input {
            width: 100%;
            border: 1px solid #d0d7de;
            border-radius: 8px;
            background: #ffffff;
            color: #111827;
            font: inherit;
            padding: 14px 15px;
            outline: none;
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }

        input:focus {
            border-color: #1f7a4d;
            box-shadow: 0 0 0 4px rgba(31, 122, 77, 0.14);
        }

        button {
            margin-top: 4px;
            border: 0;
            border-radius: 8px;
            background: #1f7a4d;
            color: #ffffff;
            cursor: pointer;
            font: inherit;
            font-weight: 750;
            padding: 14px 18px;
            transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
            box-shadow: 0 12px 24px rgba(31, 122, 77, 0.22);
        }

        button:hover {
            background: #17623d;
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }

        @media (max-width: 480px) {
            body {
                padding: 16px;
            }

            .auth-card {
                padding: 28px 22px;
            }

            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>
<body>
    <!-- create form ... use feild new passoword , confirm passoword -->

    <main class="auth-shell">
        <section class="auth-card" aria-labelledby="update-password-title">
            <div class="brand">
                <span class="brand-mark">K</span>
                <span>Kodex Auth</span>
            </div>

            <h1 id="update-password-title">Create a new password</h1>
            <p>Choose a strong password to keep your account protected.</p>
            <div class="account-chip">User ID: <%= userid%></div>

            <form action="http://localhost:3000/api/auth/update-password/<%=userid%>" method="post">
                <div class="field">
                    <label for="newPassword">New password</label>
                    <input id="newPassword" type="password" name="newPassword" placeholder="New Password">
                </div>

                <div class="field">
                    <label for="confirmPassword">Confirm password</label>
                    <input id="confirmPassword" type="password" name="confirmPassword" placeholder="Confirm Password">
                </div>

                <button type="submit">Update Password</button>
            </form>
        </section>
    </main>
</body>
</html>
